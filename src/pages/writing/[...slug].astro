---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, relatedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
}

const { post, related } = Astro.props as { post: Post; related: Post[] };
const { Content, headings } = await render(post);
---

<Article post={post} headings={headings} related={related}>
  <Content />
</Article>
