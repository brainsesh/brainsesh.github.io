---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Newsletter from '../components/Newsletter.astro';
import portrait from '../assets/lavanya.jpg';
import { SITE, TOPICS, POST_TYPES, type TopicKey } from '../site.config';
import { getPosts, postUrl, topicUrl } from '../lib/posts';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured);
const latest = posts.filter((p) => p !== featured).slice(0, 6);
const count = (key: TopicKey) => posts.filter((p) => p.data.topic === key).length;
const plural = (n: number) => (n === 1 ? '1 piece' : `${n} pieces`);
const topics: { key: TopicKey; label: string; description: string }[] = (
  Object.keys(TOPICS) as TopicKey[]
)
  .filter((key) => key !== 'finance' && key !== 'healthcare')
  .map((key) => ({
    key,
    label: key === 'ai-ml' ? 'Applied AI' : TOPICS[key].label,
    description:
      key === 'ai-ml'
        ? 'How AI and machine learning move from research into useful systems: the models, data, engineering and evaluation that make them work.'
        : TOPICS[key].description,
  }));
const READ_LABEL = {
  'paper-review': 'Read the review',
  'deep-dive': 'Read the deep dive',
  guide: 'Read the guide',
  notes: 'Read the notes',
  essay: 'Read the essay',
} as const;
---

<Base
  description={SITE.description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    author: { '@type': 'Person', name: SITE.name, sameAs: Object.values(SITE.social).filter(Boolean) },
  }}
>
  <section class="hero wrap">
    <Image
      src={portrait}
      alt={`Portrait of ${SITE.name}`}
      width={160}
      height={200}
      class="portrait"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-copy">
      <h1 class="statement">
        I explore how AI works and how research becomes real-world systems.
      </h1>
      <p class="intro">
        I'm {SITE.name}, a student of technology and a machine learning practitioner. I write about AI research, the
        ideas behind modern models, and the engineering that brings them to life with paper reviews, practical guides, notes from talks, and my own learnings.
      </p>
      <p class="actions">
        <a class="button" href="/newsletter/">Subscribe to {SITE.newsletter.name}</a>
        <a class="button button-quiet" href="/about/">About me</a>
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="wrap block" aria-labelledby="start-h">
        <h2 id="start-h" class="section-heading">
          <span>Start here</span>
        </h2>
        <article class="featured" style={`--t: ${TOPICS[featured.data.topic].color}`}>
          <p class="featured-kicker">
            <a class="topic-mark" href={topicUrl(featured.data.topic)}>
              {TOPICS[featured.data.topic].label}
            </a>
            <span>{POST_TYPES[featured.data.type]}</span>
          </p>
          <h3 class="featured-title">
            <a href={postUrl(featured)}>{featured.data.title}</a>
          </h3>
          <p class="featured-text">{featured.data.tldr ?? featured.data.description}</p>
          <a class="text-link" href={postUrl(featured)}>
            {READ_LABEL[featured.data.type]}
          </a>
        </article>
      </section>
    )
  }

  <section class="wrap block" aria-labelledby="latest-h">
    <h2 id="latest-h" class="section-heading">
      <span>Latest writing</span>
      <a href="/writing/">All writing ({posts.length})</a>
    </h2>
    <PostList posts={latest} />
  </section>

  <section class="wrap block" aria-labelledby="topics-h">
    <h2 id="topics-h" class="section-heading"><span>Topics</span></h2>
    <ul class="topics">
      {
        topics.map(({ key, label, description }) => {
          const n = count(key);
          return (
            <li style={`--t: ${TOPICS[key].color}`}>
              <h3>
                <a href={topicUrl(key)}>{label}</a>
              </h3>
              <p>{description}</p>
              <p class="count">{n > 0 ? plural(n) : 'First pieces are in progress. Subscribe to get them.'}</p>
            </li>
          );
        })
      }
    </ul>
  </section>

  <div class="wrap block">
    <Newsletter />
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 4rem);
  }
  .hero :global(.portrait) {
    width: clamp(96px, 12vw, 160px);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: var(--radius);
    margin-top: 0.5rem;
  }
  .hero-copy {
    max-width: 50rem;
  }
  .statement {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.875rem, 2.9vw + 1.05rem, 3.25rem);
    line-height: 1.16;
    letter-spacing: -0.014em;
    margin: 0;
    font-variation-settings: 'opsz' 72;
    text-wrap: balance;
  }
  .statement a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--t);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.14em;
    text-decoration-skip-ink: auto;
  }
  .statement a:hover {
    color: var(--t);
  }
  .intro {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 1.5rem 0 0;
    max-width: 40rem;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
  }

  .block {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .featured {
    border-left: 3px solid var(--t);
    padding: 0.25rem 0 0.25rem clamp(1rem, 3vw, 1.75rem);
    max-width: 52rem;
  }
  .featured-kicker {
    display: flex;
    gap: 1.25rem;
    margin: 0 0 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .featured-title {
    font-family: var(--serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    font-variation-settings: 'opsz' 48;
    text-wrap: balance;
  }
  .featured-title a {
    text-decoration: none;
  }
  .featured-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--t);
    text-underline-offset: 0.15em;
  }
  .featured-text {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0.75rem 0 1rem;
    max-width: 44rem;
  }

  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 2.5rem;
  }
  .topics li {
    border-top: 3px solid var(--t);
    padding-top: 1rem;
  }
  .topics h3 {
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 600;
    margin: 0 0 0.4rem;
    font-variation-settings: 'opsz' 32;
  }
  .topics h3 a {
    text-decoration: none;
  }
  .topics h3 a:hover {
    color: var(--t);
  }
  .topics p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .topics .count {
    margin-top: 0.75rem;
    color: var(--t);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero :global(.portrait) {
      width: 88px;
      aspect-ratio: 1;
      border-radius: 50%;
      margin: 0;
    }
  }
</style>
