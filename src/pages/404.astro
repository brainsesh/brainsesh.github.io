---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base title="Page not found" noindex>
  <div class="wrap page">
    <div class="col">
      <header class="page-head">
        <h1 class="page-title">That page isn't here.</h1>
        <p class="page-intro">
          The link may be old or mistyped. Try <a class="text-link" href="/search/">searching the site</a> or browse
          <a class="text-link" href="/writing/">all writing</a>. Here's what's new:
        </p>
      </header>
      <PostList posts={recent} />
    </div>
  </div>
</Base>
