---
import { SITE, TOPICS, type TopicKey } from '../site.config';

const year = new Date().getFullYear();
const social = [
  { href: `mailto:${SITE.email}`, label: 'Email' },
  { href: SITE.social.linkedin, label: 'LinkedIn' },
  { href: SITE.social.github, label: 'GitHub' },
  { href: SITE.social.x, label: 'X' },
  { href: SITE.social.scholar, label: 'Google Scholar' },
  { href: '/rss.xml', label: 'RSS' },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{SITE.name}</p>
      <p class="motto">{SITE.motto}</p>
    </div>
    <nav aria-label="Topics">
      <p class="label">Topics</p>
      <ul>
        {
          (Object.keys(TOPICS) as TopicKey[]).map((key) => (
            <li>
              <a href={`/topics/${key}/`}>{TOPICS[key].label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Elsewhere">
      <p class="label">Elsewhere</p>
      <ul>
        {
          social.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap fine">
    <p>{SITE.disclaimer}</p>
    <p>
      © {year} {SITE.name}. Writing is licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem 2rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }
  .name {
    font-family: var(--serif);
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.25rem;
  }
  .motto {
    margin: 0;
  }
  .label {
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  a {
    color: var(--ink-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .fine {
    margin-top: 2.5rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    display: grid;
    gap: 0.35rem;
  }
  .fine p {
    margin: 0;
    max-width: 52rem;
  }
  .fine a {
    color: inherit;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .grid > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
