---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 3 && (
    <nav class="toc" aria-label="On this page">
      <details open>
        <summary>On this page</summary>
        <ol>
          {items.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  // Highlight the section currently being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const setActive = () => {
      const first = targets.find((t) => visible.has(t));
      if (!first) return;
      links.forEach((a) => a.toggleAttribute('data-active', a.hash === `#${first.id}`));
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        setActive();
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
  // Collapse the contents on small screens so the article starts right away.
  if (matchMedia('(max-width: 1119px)').matches) {
    document.querySelector('.toc details')?.removeAttribute('open');
  }
</script>

<style>
  .toc {
    font-size: 0.875rem;
  }
  summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--ink);
    padding-block: 0.25rem;
  }
  ol {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }
  li a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-3);
    text-decoration: none;
    line-height: 1.35;
  }
  li.d3 a {
    padding-left: 1.7rem;
  }
  li a:hover {
    color: var(--ink);
  }
  li a[data-active] {
    color: var(--ink);
    border-left-color: var(--t, var(--accent));
  }
  @media (max-width: 1119px) {
    .toc {
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      padding: 0.6rem 1rem;
    }
    ol {
      margin-bottom: 0.5rem;
    }
  }
</style>
