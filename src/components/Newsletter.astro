---
import { SITE } from '../site.config';

interface Props {
  /** 'block' is the full section; 'inline' is the compact version at the end of articles. */
  variant?: 'block' | 'inline';
  heading?: string;
}
const { variant = 'block', heading } = Astro.props;
const { buttondown, name, pitch } = SITE.newsletter;
const id = `nl-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['newsletter', variant]} aria-labelledby={`${id}-h`}>
  <div class="copy">
    <h2 id={`${id}-h`}>{heading ?? `Get ${name} in your inbox`}</h2>
    <p>{pitch}</p>
  </div>
  {
    buttondown ? (
      <form
        action={`https://buttondown.com/api/emails/embed-subscribe/${buttondown}`}
        method="post"
        target="_blank"
        class="form"
      >
        <label for={`${id}-email`} class="visually-hidden">
          Email address
        </label>
        <input
          id={`${id}-email`}
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
        />
        <input type="hidden" value="1" name="embed" />
        <button class="button" type="submit">
          Subscribe
        </button>
      </form>
    ) : (
      <p class="form">
        <a class="button" href="/rss.xml">
          Follow by RSS
        </a>
      </p>
    )
  }
  {
    buttondown && (
      <p class="alt">
        Prefer a feed reader? <a href="/rss.xml">Subscribe by RSS</a>.
      </p>
    )
  }
</section>

<style>
  .newsletter {
    display: grid;
    gap: 1rem 2.5rem;
  }
  .block {
    border-top: 3px solid var(--accent);
    background: var(--paper-2);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 0 0 var(--radius) var(--radius);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
  }
  .inline {
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
  }
  h2 {
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    font-variation-settings: 'opsz' 32;
  }
  .copy p {
    margin: 0;
    color: var(--ink-2);
    max-width: 34rem;
  }
  .form {
    display: flex;
    gap: 0.5rem;
    margin: 0;
  }
  input[type='email'] {
    flex: 1;
    min-width: 0;
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  input[type='email']::placeholder {
    color: var(--ink-3);
  }
  .alt {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .alt a {
    color: inherit;
  }
  @media (max-width: 760px) {
    .block {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .form {
      flex-direction: column;
    }
  }
</style>
