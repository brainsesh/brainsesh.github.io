---
import { POST_TYPES, TOPICS } from '../site.config';
import { type Post, postUrl, topicUrl, formatDate, minutesRead, groupByYear } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Put a year heading above each group (used on the full archive). */
  byYear?: boolean;
  /** Hide the topic marker, e.g. on a topic page where every post shares it. */
  hideTopic?: boolean;
  headingLevel?: 2 | 3;
}
const { posts, byYear = false, hideTopic = false, headingLevel = 3 } = Astro.props;
const groups = byYear ? groupByYear(posts) : [[null, posts] as const];
const H = `h${headingLevel}` as 'h2' | 'h3';
---

{
  groups.map(([year, group]) => (
    <section class="group" aria-label={year ? String(year) : undefined}>
      {year && <h2 class="year">{year}</h2>}
      <ol class="posts">
        {group.map((post) => {
          const topic = TOPICS[post.data.topic];
          return (
            <li class="post" style={`--t: ${topic.color}`}>
              <time class="date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <div class="body">
                <H class="title">
                  <a href={postUrl(post)}>{post.data.title}</a>
                  {post.data.draft && <span class="draft">Draft</span>}
                </H>
                <p class="desc">{post.data.description}</p>
                <p class="meta">
                  {!hideTopic && (
                    <a class="topic-mark" href={topicUrl(post.data.topic)}>
                      {topic.label}
                    </a>
                  )}
                  <span>{POST_TYPES[post.data.type]}</span>
                  <span>{minutesRead(post)} min read</span>
                </p>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  ))
}

<style>
  .group + .group {
    margin-top: 2.5rem;
  }
  .year {
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 600;
    margin: 0 0 0.5rem;
    font-variation-settings: 'opsz' 32;
    font-variant-numeric: lining-nums;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
    position: relative;
  }
  .post:first-child {
    border-top: 0;
  }
  .date {
    font-size: var(--step--1);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 0.35rem;
  }
  .title {
    font-family: var(--serif);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    font-variation-settings: 'opsz' 28;
    text-wrap: balance;
  }
  .title a {
    text-decoration: none;
    color: var(--ink);
    background-image: linear-gradient(var(--t), var(--t));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
  }
  .title a:hover {
    background-size: 100% 2px;
  }
  .title a:focus-visible {
    outline-offset: 2px;
  }
  .draft {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--topic-health);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .desc {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    max-width: 40rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  @media (max-width: 640px) {
    .post {
      grid-template-columns: 1fr;
    }
    .date {
      padding-top: 0;
      order: 2;
    }
    .body {
      display: contents;
    }
    .title {
      order: 1;
    }
    .desc {
      order: 3;
    }
    .meta {
      order: 4;
    }
  }
</style>
